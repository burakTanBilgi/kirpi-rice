#!/usr/bin/env python3
"""kimera-deck-panel: Kirpi's deck. One window, drawn over the still artwork.

It only shows. Six letters are taken from the keyboard:
  s stop this answer   d close the door   b tasks, open or close   r rest now   t a terminal   o shut down
What does not exist yet (the door) says so; nothing here is invented.
The model is read from llama.cpp's own server on this machine, when it runs.

  kimera-deck-panel                 the window, under sway
  kimera-deck-panel --png out.png   one frame to a file, to check it away from Kirpi
"""
import os, sys, time, subprocess, json, glob
import urllib.request, urllib.error
import gi
gi.require_version('Pango', '1.0'); gi.require_version('PangoCairo', '1.0')
from gi.repository import Pango, PangoCairo
import cairo

CH, OR, TE, SG, BO, TL = '#1f1c1a', '#E8873A', '#4C8782', '#608A6E', '#f6cfa0', '#8cc0b5'
ST, SP = 'Big Shoulders Stencil', 'Space Mono'
W, H = 1600, 900                       # the design size; the window is scaled to it
ART = os.environ.get('KIMERA_ART', '/usr/local/share/kimera/kirpi-deck.png')
FOOT_INI = '/etc/kimera/foot.ini'
MODEL_PROGRAM = 'llama-server'
MIND = 'http://127.0.0.1:8080'           # llama.cpp's server; it listens on this machine only
MODELS = os.path.expanduser('~/kimera/models/*.gguf')
HZ = os.sysconf('SC_CLK_TCK'); PAGE = os.sysconf('SC_PAGE_SIZE'); NCPU = os.cpu_count() or 1
CONTROL = [('s', 'stop this answer'), ('d', 'close the door'), ('b', 'tasks, open or close'),
           ('r', 'rest now'), ('t', 'a terminal'), ('o', 'shut down')]


def rgb(h): return tuple(int(h[i:i + 2], 16) / 255 for i in (1, 3, 5))


def text(cr, x, y, s, size, col, fam=SP, weight=400, anchor='start', spacing=0, alpha=1.0):
    """Draw s with its baseline at y. Returns the width drawn."""
    lay = PangoCairo.create_layout(cr)
    fd = Pango.FontDescription()
    fd.set_family(fam); fd.set_absolute_size(size * Pango.SCALE); fd.set_weight(Pango.Weight(weight))
    lay.set_font_description(fd)
    if spacing:
        al = Pango.AttrList(); al.insert(Pango.attr_letter_spacing_new(int(spacing * Pango.SCALE)))
        lay.set_attributes(al)
    lay.set_text(s, -1)
    w = lay.get_size()[0] / Pango.SCALE - spacing
    if anchor == 'end': x -= w
    elif anchor == 'middle': x -= w / 2
    cr.set_source_rgba(*rgb(col), alpha)
    cr.move_to(x, y - lay.get_baseline() / Pango.SCALE)
    PangoCairo.show_layout(cr, lay)
    return w


def fit(cr, x, y, s, size, room, *a, **k):
    """Like text, but smaller when s would not fit in room."""
    while size > 12:
        lay = PangoCairo.create_layout(cr)
        fd = Pango.FontDescription(); fd.set_family(a[1] if len(a) > 1 else SP)
        fd.set_absolute_size(size * Pango.SCALE); fd.set_weight(Pango.Weight(a[2] if len(a) > 2 else 400))
        lay.set_font_description(fd); lay.set_text(s, -1)
        if lay.get_size()[0] / Pango.SCALE + len(s) * k.get('spacing', 0) <= room: break
        size -= 2
    return text(cr, x, y, s, size, *a, **k)


class State:
    def __init__(self):
        self.tasks = False             # the tasks section, closed until B
        self.msg = ''                  # the control terminal's last line
        self.off_until = 0.0           # while in the future, the shut-down question is on screen
        self.hist = []                 # processor load, 0..1, newest last
        self.load = 0.0
        self.procs = []                # the heaviest four: (name, bytes, percent)
        self.mind = {'state': 'none', 'name': '', 'tps': None, 'decoded': None, 'total': None}
        self._cpu = None; self._pt = {}; self._t = None
        self.sample()

    def sample(self):
        now = time.monotonic()
        with open('/proc/stat') as f: v = [int(x) for x in f.readline().split()[1:9]]
        total, idle = sum(v), v[3] + v[4]
        if self._cpu and total > self._cpu[0]:
            self.load = 1 - (idle - self._cpu[1]) / (total - self._cpu[0])
            self.hist = (self.hist + [self.load])[-40:]
        self._cpu = (total, idle)
        self._mind()
        if self.tasks: self._processes(now)
        else: self._pt = {}; self.procs = []
        self._t = now

    def _processes(self, now):
        dt = (now - self._t) if self._t else 0
        seen, rows = {}, []
        for pid in os.listdir('/proc'):
            if not pid.isdigit(): continue
            try:
                with open(f'/proc/{pid}/stat') as f: s = f.read()
            except OSError: continue
            name = s[s.index('(') + 1:s.rindex(')')]; r = s[s.rindex(')') + 2:].split()
            ticks, rss = int(r[11]) + int(r[12]), int(r[21]) * PAGE
            seen[pid] = ticks
            if rss == 0: continue      # kernel threads hold no memory of their own
            pct = 100 * (ticks - self._pt[pid]) / (dt * HZ * NCPU) if dt > 0 and pid in self._pt else 0.0
            rows.append((name, rss, pct))
        self._pt = seen
        self.procs = sorted(rows, key=lambda p: (-round(p[2], 1), -p[1]))[:4]

    def _mind(self):
        """Ask the model's server how it is. Never waits long: it is on this machine or it is not there."""
        m = self.mind
        def get(path):
            with urllib.request.urlopen(MIND + path, timeout=0.4) as r: return r.read()
        try:
            try: get('/health')
            except urllib.error.HTTPError as e:
                if e.code == 503: m['state'] = 'loading'; return
                raise
            if not m['name']:
                m['name'] = json.loads(get('/v1/models'))['data'][0]['id'].replace('-', ' ').upper()
            busy = [s for s in json.loads(get('/slots')) if s.get('is_processing')]
            m['state'] = 'answering' if busy else 'idle'
            m['decoded'] = find(busy[0], 'n_decoded') if busy else None
            for line in get('/metrics').decode().splitlines():
                if line.startswith('llamacpp:predicted_tokens_seconds '): m['tps'] = float(line.split()[1])
                elif line.startswith('llamacpp:tokens_predicted_total '): m['total'] = int(float(line.split()[1]))
        except (OSError, ValueError, KeyError, IndexError):
            files = glob.glob(MODELS)
            m['state'] = 'off' if files else 'none'
            m['name'] = os.path.basename(files[0]).split('-Q')[0].replace('-', ' ').upper() if files else ''

    def memory(self):
        m = {}
        with open('/proc/meminfo') as f:
            for line in f:
                k, v = line.split(':'); m[k] = int(v.split()[0]) * 1024
        model = 0
        for pid in os.listdir('/proc'):
            if not pid.isdigit(): continue
            try:
                with open(f'/proc/{pid}/comm') as f:
                    if f.read().strip() != MODEL_PROGRAM: continue
                with open(f'/proc/{pid}/statm') as f: model += int(f.read().split()[1]) * PAGE
            except OSError: continue
        total, free = m['MemTotal'], m['MemAvailable']
        return total, free, min(model, total - free), max(0, total - free - model)


def find(d, key):
    """The first value under key, however deep it sits."""
    if isinstance(d, dict):
        if key in d: return d[key]
        d = list(d.values())
    if isinstance(d, list):
        for v in d:
            r = find(v, key)
            if r is not None: return r
    return None


def gb(b): return f'{b / 2**30:.1f}'


def size(b): return f'{b / 2**30:.1f}G' if b >= 2**30 else f'{b / 2**20:.0f}M'


def uptime():
    with open('/proc/uptime') as f: s = float(f.read().split()[0])
    for n, unit in ((86400, 'day'), (3600, 'hour'), (60, 'minute')):
        if s >= n: k = int(s // n); return f'up {k} {unit}' + ('s' if k != 1 else '')
    return 'up a moment'


def strip(cr, x, y, w, title, right=''):
    text(cr, x + 16, y + 33, title, 30, CH, ST, 900, spacing=3)
    if right: text(cr, x + w - 16, y + 30, right, 17, CH, SP, 700, 'end')


def draw(cr, st):
    cr.set_antialias(cairo.ANTIALIAS_DEFAULT)
    # the name
    text(cr, 192, 124, 'kirpi', 98, OR, ST, 900, 'middle', 5)

    # memory and the clock, on the orange plate
    total, free, model, system = st.memory()
    text(cr, 50, 374, 'MEMORY', 16, CH, SP, 700, spacing=3)
    text(cr, 334, 374, f'OF {gb(total)} GB', 16, CH, SP, 700, 'end')
    text(cr, 47, 428, f'{gb(free)} GB FREE', 56, CH, ST, 900, spacing=2)
    x, y, w, h, gap = 50, 442, 284, 30, 4
    parts = [(p, n) for p, n in ((model, 'model'), (system, 'sys'), (free, 'free')) if p > 0]
    room = w - gap * (len(parts) - 1)
    for p, n in parts:
        pw = max(6, room * p / total)
        cr.set_source_rgb(*rgb(CH)); cr.set_line_width(2.4)
        if n == 'model': cr.rectangle(x, y, pw, h); cr.fill()
        else:
            cr.rectangle(x + 1.2, y + 1.2, pw - 2.4, h - 2.4); cr.stroke()
            if n == 'sys':                 # hatched: held by the system
                cr.save(); cr.rectangle(x, y, pw, h); cr.clip(); cr.set_line_width(3)
                k = x - h
                while k < x + pw: cr.move_to(k, y + h); cr.line_to(k + h, y); k += 7
                cr.stroke(); cr.restore()
        x += pw + gap
    labels = [f'{n} {gb(p)}' for p, n in parts]
    text(cr, 50, 494, labels[0], 16, CH, SP, 700)
    if len(labels) == 3: text(cr, 192, 494, labels[1], 16, CH, SP, 700, 'middle')
    text(cr, 334, 494, labels[-1], 16, CH, SP, 700, 'end')
    text(cr, 47, 554, time.strftime('%H:%M'), 54, CH, ST, 900, spacing=2)
    text(cr, 334, 536, time.strftime('%a %d %b').upper(), 17, CH, SP, 700, 'end')

    # control: the five letters and what the last one did
    strip(cr, 32, 572, 320, 'CONTROL')
    for i, (k, v) in enumerate(CONTROL):
        text(cr, 52, 654 + i * 31, k, 19, BO, SP, 700); text(cr, 88, 654 + i * 31, v, 18, OR, SP)
    w = text(cr, 52, 850, 'kirpi ›', 19, BO, SP, 700)
    w += text(cr, 52 + w + 12, 850, st.msg, 18, TL, SP) + (12 if st.msg else 0)
    cr.set_source_rgb(*rgb(BO)); cr.rectangle(52 + w + 12, 832, 12, 23); cr.fill()

    # the mind: what llama.cpp's server says about itself
    m = st.mind; state = m['state']
    text(cr, 406, 86, 'THE MIND HOLDS', 15, CH, SP, 700, spacing=3)
    fit(cr, 404, 142, m['name'] or 'NO MODEL YET', 58, 310, CH, ST, 900, spacing=2)
    word = {'none': 'EMPTY', 'off': 'OFF', 'loading': 'LOADING', 'idle': 'IDLE', 'answering': 'ANSWERING'}[state]
    fit(cr, 866, 120, word, 40, 236, OR, ST, 900, 'middle', spacing=3)
    if state in ('idle', 'answering'):
        line = f"{m['tps']:.0f} tokens a second" if m['tps'] else 'no answer yet'
    else: line = {'none': 'nothing is loaded', 'off': 'not running', 'loading': 'reading the model'}[state]
    text(cr, 1034, 100, line, 19, CH, SP, 700)
    if model: text(cr, 1034, 128, f'{gb(model)} GB held', 17, CH, SP, 700)
    with open('/proc/loadavg') as f: text(cr, 1526, 100, 'load ' + f.read().split()[0], 17, CH, SP, 700, 'end')
    text(cr, 1526, 128, uptime(), 17, CH, SP, 700, 'end')

    strip(cr, 388, 188, 772, 'NOW ANSWERING')
    if state == 'answering':
        text(cr, 406, 286, '› answering now', 21, BO, SP, 700)
        if m['decoded'] is not None: text(cr, 406, 326, f"{m['decoded']} tokens so far", 21, OR, SP)
        text(cr, 406, 566, 'who asked, and the words, are not shown yet', 17, TL, SP)
    elif state == 'idle':
        text(cr, 406, 286, 'no question now', 21, TL, SP)
        if m['total']: text(cr, 406, 566, f"{m['total']} tokens answered since it started", 17, TL, SP)
    else:
        text(cr, 406, 286, 'no question yet', 21, TL, SP)

    strip(cr, 1184, 188, 360, 'THE DOOR')
    text(cr, 1202, 290, 'NO DOOR YET', 52, OR, ST, 900, spacing=3)
    text(cr, 1204, 322, 'nobody is let in from here', 17, TL, SP, 700)

    # tasks: closed until B; open, a graph of the processor and the heaviest four
    strip(cr, 388, 624, 772, 'TASKS', f'PROCESSOR {round(st.load * 100)}%')
    if not st.tasks:
        text(cr, 406, 716, 'closed · b opens it', 21, TL, SP)
    else:
        first = 40 - len(st.hist)
        for i, v in enumerate(st.hist):
            for j in range(max(1, round(v * 13))):
                cr.set_source_rgb(*rgb(TL if j < 5 else SG if j < 9 else OR))
                cr.arc(410 + (first + i) * 9, 824 - j * 9.5, 2.9, 0, 6.2832); cr.fill()
        text(cr, 800, 700, 'program', 15, TL, SP)
        text(cr, 1040, 700, 'memory', 15, TL, SP, 400, 'end'); text(cr, 1142, 700, '%', 15, TL, SP, 400, 'end')
        for i, (name, rss, pct) in enumerate(st.procs):
            y = 734 + i * 30
            text(cr, 800, y, name[:15], 18, BO if i == 0 else OR, SP, 700 if i == 0 else 400)
            text(cr, 1040, y, size(rss), 18, TL, SP, 400, 'end')
            text(cr, 1142, y, f'{pct:.1f}', 18, OR, SP, 700, 'end')

    strip(cr, 1184, 624, 360, 'EARLIER', 'TOKENS')
    text(cr, 1202, 716, 'nothing yet', 17, TL, SP)


def confirm_off(cr, st):
    """The shut-down question, over everything: Y shuts down, N or Esc keeps running, 15 s and it goes away."""
    left = st.off_until - time.time()
    if left <= 0: return
    cr.set_source_rgba(*rgb(CH), 0.88); cr.rectangle(0, 0, W, H); cr.fill()
    cr.set_source_rgb(*rgb(BO)); cr.rectangle(420, 300, 760, 300); cr.fill()
    cr.set_source_rgb(*rgb(CH)); cr.rectangle(432, 312, 736, 276); cr.fill()
    text(cr, 800, 390, 'SHUT KIRPI DOWN?', 58, OR, ST, 900, 'middle', 3)
    text(cr, 800, 440, 'the model finishes its answer, stops, and the machine powers off', 17, TL, SP, 400, 'middle')
    text(cr, 640, 530, 'Y', 44, BO, ST, 900, 'middle'); text(cr, 640, 562, 'shut down', 18, OR, SP, 700, 'middle')
    text(cr, 960, 530, 'N', 44, BO, ST, 900, 'middle'); text(cr, 960, 562, 'keep running', 18, OR, SP, 700, 'middle')
    text(cr, 800, 584, f'goes away in {int(left) + 1} s', 14, TL, SP, 400, 'middle')


def frame(cr, art, w, h, st):
    cr.set_source_rgb(*rgb(CH)); cr.paint()
    if art:
        cr.save(); cr.scale(w / art.get_width(), h / art.get_height())
        cr.set_source_surface(art, 0, 0); cr.paint(); cr.restore()
    cr.scale(w / W, h / H)
    draw(cr, st)
    confirm_off(cr, st)


def load_art():
    try: return cairo.ImageSurface.create_from_png(ART)
    except Exception: return None


def to_png(path, tasks):
    st = State(); st.tasks = tasks
    if tasks:
        st.msg = 'tasks open'
        for _ in range(3): time.sleep(0.5); st.sample()
    surf = cairo.ImageSurface(cairo.FORMAT_RGB24, 1920, 1080)
    frame(cairo.Context(surf), load_art(), 1920, 1080, st); surf.write_to_png(path)


def window():
    gi.require_version('Gtk', '3.0'); gi.require_version('Gdk', '3.0')
    from gi.repository import Gtk, Gdk, GLib
    GLib.set_prgname('kimera-deck')
    st, art = State(), load_art()
    win = Gtk.Window(title='kimera-deck'); area = Gtk.DrawingArea(); win.add(area)

    def on_draw(_w, cr):
        a = area.get_allocation(); frame(cr, art, a.width, a.height, st)

    def tick():
        st.sample(); area.queue_draw(); return True

    def on_key(_w, ev):
        k = Gdk.keyval_name(ev.keyval).lower()
        if st.off_until > time.time():             # the question is open: only Y and N count
            if k == 'y':
                st.off_until = 0; st.msg = 'shutting down'
                subprocess.Popen(['/usr/local/bin/kimera-poweroff'])
            elif k in ('n', 'escape'): st.off_until = 0; st.msg = 'staying on'
            area.queue_draw(); return True
        if k == 'o': st.off_until = time.time() + 15
        elif k == 'b':
            st.tasks = not st.tasks; st.msg = 'tasks open' if st.tasks else 'tasks closed'; st.sample()
        elif k == 's': st.msg = 'cannot stop yet' if st.mind['state'] == 'answering' else 'nothing to stop'
        elif k == 'd': st.msg = 'no door yet'
        elif k == 't':
            st.msg = 'a terminal'
            subprocess.Popen(['foot', '--app-id=kimera-term', '-c', FOOT_INI, '--login-shell'])
        elif k == 'r':
            st.msg = 'resting'; subprocess.Popen(['swaymsg', 'exit'])
        else: return False
        area.queue_draw(); return True

    area.connect('draw', on_draw); win.connect('key-press-event', on_key); win.connect('destroy', Gtk.main_quit)
    GLib.timeout_add_seconds(2, tick)
    win.show_all(); Gtk.main()


if __name__ == '__main__':
    if len(sys.argv) >= 3 and sys.argv[1] == '--png': to_png(sys.argv[2], '--tasks' in sys.argv)
    else: window()
