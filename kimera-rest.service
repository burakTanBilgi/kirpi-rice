[Unit]
Description=Kimera: the resting screen on the first console
After=systemd-user-sessions.service getty@tty1.service
Conflicts=getty@tty1.service

[Service]
User=@USER@
PAMName=login
Environment=TERM=linux
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
StandardOutput=tty
UtmpIdentifier=tty1
UtmpMode=user
ExecStartPre=+-/usr/bin/setfont -C /dev/tty1 /usr/local/share/kimera/kirpi-32x16.psf.gz
ExecStart=/usr/local/bin/kimera-rest
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
